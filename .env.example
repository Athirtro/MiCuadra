# Copia este archivo a `.env` (nunca lo subas al repo). Lo lee apps/api.
# En staging/prod estos valores van en Render (API) y Vercel (web), no en archivos.

# dev | test | staging | prod
ENTORNO=dev

# Postgres con PostGIS. Local: Postgres de Homebrew/Postgres.app.
# Supabase: Project Settings → Database → Connection string (usa el "Session pooler").
DATABASE_URL=postgresql://localhost:5432/micuadra

# Supabase Auth. Con SUPABASE_JWT_SECRET el API valida tokens HS256 (local y secreto legado).
# Si se deja vacío, valida con las llaves públicas (JWKS) de SUPABASE_URL.
SUPABASE_URL=
SUPABASE_JWT_SECRET=solo-para-desarrollo-local-cambia-esto-32+
SUPABASE_JWT_AUDIENCE=authenticated

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Feature flags (SPEC.md §4)
MANDADOS_ACTIVOS=false
MODALIDAD_A_ACTIVA=false
PAGOS_PROVEEDOR=manual

# Geocoding API de Google (opcional). Con la clave, la carga por CSV del admin ubica sola las
# filas que traen dirección pero no coordenadas. Restríngela a "Geocoding API" en Google Cloud.
GOOGLE_GEOCODING_KEY=
