          "nombre",
          "icono",
          "color"
        ],
        "title": "CategoriaCorta"
      },
      "Disponibilidad": {
        "properties": {
          "disponible": {
            "type": "boolean",
            "title": "Disponible"
          },
          "razon": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "proximamente",
                  "sin_mensajeros",
                  "fuera_de_cobertura"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Razon"
          },
          "mensajeros_activos": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mensajeros Activos"
          },
          "tarifa_desde": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tarifa Desde"
          }
        },
        "type": "object",
        "required": [
          "disponible"
        ],
        "title": "Disponibilidad",
        "description": "Contrato de `GET /negocios/{id}/mandados-disponibles`. No cambia entre fases."
      },
      "EventoEntrada": {
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "vista_perfil",
              "click_whatsapp",
              "click_pedir_mandado",
              "click_como_llegar",
              "busqueda",
              "sesion"
            ],
            "title": "Tipo"
          },
          "anon_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Anon Id",
            "description": "Id aleatorio guardado en el navegador; sin datos personales"
          },
          "negocio_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Negocio Id"
          },
          "metadata": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
