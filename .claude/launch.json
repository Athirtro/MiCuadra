{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@micuadra/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-api-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@micuadra/web",
        "dev"
      ],
      "port": 5173,
      "env": {
        "VITE_API_URL": "https://micuadra-api.onrender.com/api/v1"
      }
    }
  ]
}